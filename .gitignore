# Byte-compiled
__pycache__/
*.pyc
*.pyo

# The hand-rolled snapshots git replaces. Kept ignored rather than deleted so
# an old .bak lying around never silently becomes a tracked file.
*.bak
*.bak-*
*.orig

# Local tool + OS noise
.claude/
Thumbs.db
desktop.ini

# Scratch. The .bak snapshots git already replaces were swept in here on
# 2026-08-29 rather than deleted, so an old copy is still reachable by hand
# without ever becoming a tracked file. Nothing in here is loaded by anything.
temp/
